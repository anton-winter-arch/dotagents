.DS_Store
__archive*/

# macOS
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Per-device runtime view (agent-mail inbox, local assembly) - never sync
.claude/
inbox/
settings.local.json

# teach-me learning artifacts (personal, never sync)
LEARNING/

# Python bytecode (embeds absolute source paths)
__pycache__/
*.py[cod]

# okf-kg / obsidian-kg SQLite databases (built per-vault, never committed)
.okf-kg.db
.okf-kg.db-*
.obsidian-kg.db
.obsidian-kg.db-*

# Logs / temp / backups
*.log
*.tmp
*.bak

# Secrets safety net
.env
.env.*
*.local

# Keys and credentials - never commit, in any repo
*.pem
*.key
*.p12
*.pfx
id_rsa*
.envrc
*credentials*

# Upstream-only: working state, not part of the published set
/tasks/
/_RESEARCH/